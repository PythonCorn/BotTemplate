# Git
.git/
.gitignore
.github/

# Docker files not needed inside image
Dockerfile*
docker-compose*.yml
.dockerignore

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Python tools cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.hypothesis/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Environment variables / secrets
.env
.env.*
!.env.example
!.env.template

# Local databases / dumps
*.sqlite
*.sqlite3
*.db
*.dump
*.sql

# Logs / coverage
logs/
*.log
log.txt
.coverage
.coverage.*
coverage.xml
htmlcov/

# IDE / editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local runtime data
data/
redis-data/
tmp/
temp/
.cache/

# Telegram / bot runtime files
*.session
*.session-journal

# Alembic local temp files
alembic/.env
alembic/**/*.pyc

# Tests are usually not needed in production image
tests/
